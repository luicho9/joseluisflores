---
import ArrowRight from "@/components/icons/ArrowRight.astro";
---

<section class="flex flex-col mt-12">
  <div class="border-b py-2">
    <h2 class="font-bold">Education</h2>
  </div>
  <div class="mt-4">
    <div class="flex justify-between w-full">
      <h2>
        <span class="sm:hidden">UNICAH</span>
        <span class="hidden sm:inline">Universidad Católica de Honduras</span>
      </h2>
      <p class="text-primary/80 flex items-center gap-1 text-nowrap">
        Sep 2022 <ArrowRight /> Jul 2026
      </p>
    </div>
    <p class="text-primary/80">Computer Science Engineering</p>
    <p class="mt-1 text-sm text-primary/60">Summa Cum Laude.</p>
  </div>
</section>
